# Configuration template only. Fill secrets through local .env.local / platform settings.
# No infrastructure or credential is created by this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres: pooled for the app, direct for migration CLI.
DATABASE_URL=
DIRECT_URL=

# Neon Managed Better Auth; branch-specific URL, server-owned cookie secret (32+ chars).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Cloudflare private R2. Use separate bucket/prefix and keys per environment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=development

# Meta Model API. These names are application configuration except MODEL_API_KEY.
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
META_ANALYSIS_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0

# Proposed GPU host for Meta SAM 3D Objects. Verify access and pricing in Phase 0.
SAM3D_PROVIDER=fal
SAM3D_MODEL=fal-ai/sam-3/3d-objects
FAL_KEY=

# App-enforced limits; implement server-side validation, never trust browser values.
MAX_SCENE_OBJECTS=5
MAX_UPLOAD_BYTES=12582912
MAX_RUN_SECONDS=480
MAX_ACTIVE_RUNS_PER_USER=1
GENERATION_ENABLED=false
# Budget values are proposed controls, not purchase authorization.
GENERATION_BUDGET_USD=20
GENERATION_MAX_RESERVED_USD_PER_RUN=1

# Optional features default off until core flow passes.
ENABLE_MUSE_IMAGE=false
ENABLE_VOICE_COMMANDS=false

# Vercel Workflow uses deployment integration. Add only documented SDK variables
# required by the version selected during scaffolding; never commit OIDC tokens.
