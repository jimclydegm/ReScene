{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "handedness": {
          "type": "string",
          "const": "right"
        },
        "upAxis": {
          "type": "string",
          "const": "Y"
        },
        "units": {
          "type": "string",
          "const": "approximate"
        }
      },
      "required": [
        "handedness",
        "upAxis",
        "units"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "approximateGeometry": {
      "type": "boolean",
      "const": true
    },
    "composition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "sam3d-room-v1"
            },
            "layoutSource": {
              "type": "string",
              "enum": [
                "sam3d",
                "manual-stage"
              ]
            },
            "floorY": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "backdrop": {
              "type": "string",
              "enum": [
                "room",
                "studio",
                "none"
              ]
            },
            "background": {
              "type": "object",
              "properties": {
                "surfaceMode": {
                  "type": "string",
                  "const": "materials"
                },
                "transition": {
                  "type": "string",
                  "enum": [
                    "open",
                    "curve"
                  ]
                },
                "junctions": {
                  "minItems": 2,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "materials": {
                  "type": "object",
                  "properties": {
                    "ground": {
                      "type": "object",
                      "properties": {
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "roughness": {
                          "type": "number",
                          "minimum": 0.2,
                          "maximum": 1
                        },
                        "tileSize": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 10
                        }
                      },
                      "required": [
                        "color",
                        "roughness",
                        "tileSize"
                      ],
                      "additionalProperties": false
                    },
                    "wall": {
                      "type": "object",
                      "properties": {
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "roughness": {
                          "type": "number",
                          "minimum": 0.2,
                          "maximum": 1
                        },
                        "tileSize": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 10
                        }
                      },
                      "required": [
                        "color",
                        "roughness",
                        "tileSize"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "ground",
                    "wall"
                  ],
                  "additionalProperties": false
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "seamless",
                    "planes",
                    "distant"
                  ]
                },
                "groundVisible": {
                  "type": "boolean"
                },
                "plainColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "boundary": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "leftY": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "rightY": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "leftY",
                        "rightY"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "kind",
                "groundVisible",
                "boundary",
                "description"
              ],
              "additionalProperties": false
            },
            "camera": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "target": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "fov": {
                  "type": "number",
                  "minimum": 20,
                  "maximum": 85
                },
                "aspect": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "position",
                "target",
                "fov",
                "aspect"
              ],
              "additionalProperties": false
            },
            "room": {
              "type": "object",
              "properties": {
                "centerX": {
                  "type": "number"
                },
                "centerZ": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "depth": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "centerX",
                "centerZ",
                "width",
                "depth",
                "height"
              ],
              "additionalProperties": false
            },
            "environment": {
              "type": "object",
              "properties": {
                "floorColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "wallColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "floorMaterial": {
                  "type": "string",
                  "enum": [
                    "wood",
                    "tile",
                    "carpet",
                    "plain"
                  ]
                },
                "lightDirection": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right",
                    "front",
                    "overhead",
                    "diffuse"
                  ]
                },
                "lightWarmth": {
                  "type": "string",
                  "enum": [
                    "warm",
                    "neutral",
                    "cool"
                  ]
                },
                "sideWall": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right",
                    "none"
                  ]
                }
              },
              "required": [
                "floorColor",
                "wallColor",
                "floorMaterial",
                "lightDirection",
                "lightWarmth",
                "sideWall"
              ],
              "additionalProperties": false
            },
            "environmentSource": {
              "type": "string",
              "enum": [
                "spark",
                "photo-colors"
              ]
            },
            "projectionError": {
              "type": "number",
              "minimum": 0
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "version",
            "camera",
            "room",
            "environment",
            "environmentSource",
            "projectionError",
            "warnings"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "lighting": {
      "type": "object",
      "properties": {
        "key": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20
                },
                {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 20
                },
                {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            }
          },
          "required": [
            "position",
            "intensity"
          ],
          "additionalProperties": false
        },
        "fill": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20
                },
                {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 20
                },
                {
                  "type": "number",
                  "minimum": -20,
                  "maximum": 20
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            }
          },
          "required": [
            "position",
            "intensity"
          ],
          "additionalProperties": false
        },
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "key",
        "fill",
        "ambient"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "floorAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "wallAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "backgroundAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "floorAssetId",
        "wallAssetId"
      ],
      "additionalProperties": false
    },
    "objects": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tint": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelAssetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "transform": {
            "type": "object",
            "properties": {
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              },
              "scale": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "position",
              "rotation",
              "scale"
            ],
            "additionalProperties": false
          },
          "productId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "modelAssetId",
          "transform",
          "productId"
        ],
        "additionalProperties": false
      }
    },
    "products": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "brand": {
            "type": "string",
            "maxLength": 120
          },
          "price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,8})(\\.\\d{1,2})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "USD",
                  "PHP",
                  "EUR",
                  "GBP",
                  "JPY",
                  "AUD",
                  "CAD",
                  "SGD",
                  "INR"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "productUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "imageAssetId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "description",
          "brand",
          "price",
          "currency",
          "productUrl",
          "id",
          "imageAssetId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "coordinates",
    "title",
    "description",
    "revision",
    "approximateGeometry",
    "composition",
    "lighting",
    "surfaces",
    "objects",
    "products"
  ],
  "additionalProperties": false
}
