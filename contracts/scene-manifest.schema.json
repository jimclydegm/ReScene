{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rescene:scene-manifest:v1",
  "title": "ReScene Scene Manifest v1",
  "description": "Canonical render snapshot. Contains asset IDs, never storage keys or signed URLs. Ownership, references, and quaternion norms also require service validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "revision", "title", "description", "coordinates", "approximateGeometry", "camera", "stage", "posterAssetId", "objects", "products"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sceneId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "upAxis", "units"],
      "properties": {
        "handedness": { "const": "right" },
        "upAxis": { "const": "Y" },
        "units": { "enum": ["approximate", "meters"] }
      }
    },
    "approximateGeometry": { "const": true },
    "camera": { "$ref": "#/$defs/camera" },
    "stage": { "$ref": "#/$defs/stage" },
    "posterAssetId": { "$ref": "#/$defs/nullableId" },
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "$ref": "#/$defs/sceneObject" }
    },
    "products": {
      "type": "array", "maxItems": 12,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "nullableId": { "type": ["string", "null"], "format": "uuid" },
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number", "minimum": -1000, "maximum": 1000 }
    },
    "size3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
    },
    "scale3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number", "minimum": 0.01, "maximum": 100 }
    },
    "quaternion": {
      "description": "Order x,y,z,w. Must have unit norm; service validates the norm.",
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number", "minimum": -1, "maximum": 1 }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "transform": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "rotation", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quaternion" },
        "scale": { "$ref": "#/$defs/scale3" }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "target", "fovDegrees", "minDistance", "maxDistance", "maxPolarAngle"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "target": { "$ref": "#/$defs/vec3" },
        "fovDegrees": { "type": "number", "minimum": 20, "maximum": 90 },
        "minDistance": { "type": "number", "minimum": 0.1, "maximum": 100 },
        "maxDistance": { "type": "number", "minimum": 0.2, "maximum": 1000 },
        "maxPolarAngle": { "description": "Radians, keeping the camera above the floor.", "type": "number", "minimum": 0.1, "maximum": 1.5708 }
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "size", "floorColor", "wallColor", "showWalls"],
      "properties": {
        "type": { "const": "simple-room" },
        "size": { "$ref": "#/$defs/size3" },
        "floorColor": { "$ref": "#/$defs/color" },
        "wallColor": { "$ref": "#/$defs/color" },
        "showWalls": { "type": "boolean" }
      }
    },
    "sceneObject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "category", "representation", "geometrySource", "modelAssetId", "cutoutAssetId", "productId", "visible", "transform", "localBounds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "representation": { "enum": ["MESH", "CUTOUT", "PROXY"] },
        "geometrySource": { "enum": ["SAM3D", "CATALOG", "CUTOUT", "PROXY"] },
        "modelAssetId": { "$ref": "#/$defs/nullableId" },
        "cutoutAssetId": { "$ref": "#/$defs/nullableId" },
        "productId": { "$ref": "#/$defs/nullableId" },
        "visible": { "type": "boolean" },
        "transform": { "$ref": "#/$defs/transform" },
        "localBounds": { "$ref": "#/$defs/size3" }
      },
      "allOf": [
        {
          "if": { "properties": { "representation": { "const": "MESH" } }, "required": ["representation"] },
          "then": { "properties": { "modelAssetId": { "$ref": "#/$defs/id" }, "cutoutAssetId": { "const": null }, "geometrySource": { "enum": ["SAM3D", "CATALOG"] } } }
        },
        {
          "if": { "properties": { "representation": { "const": "CUTOUT" } }, "required": ["representation"] },
          "then": { "properties": { "cutoutAssetId": { "$ref": "#/$defs/id" }, "modelAssetId": { "const": null }, "geometrySource": { "const": "CUTOUT" } } }
        },
        {
          "if": { "properties": { "representation": { "const": "PROXY" } }, "required": ["representation"] },
          "then": { "properties": { "modelAssetId": { "const": null }, "cutoutAssetId": { "const": null }, "geometrySource": { "const": "PROXY" } } }
        }
      ]
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "brand", "sku", "price", "currency", "productUrl", "imageAssetId", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": ["string", "null"], "maxLength": 4000 },
        "brand": { "type": ["string", "null"], "maxLength": 120 },
        "sku": { "type": ["string", "null"], "maxLength": 120 },
        "price": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$" },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "productUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "imageAssetId": { "$ref": "#/$defs/nullableId" },
        "attributes": { "type": "object", "maxProperties": 12, "additionalProperties": { "type": "string", "maxLength": 500 } }
      },
      "allOf": [
        {
          "if": { "properties": { "price": { "type": "string" } }, "required": ["price"] },
          "then": { "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } },
          "else": { "properties": { "currency": { "const": null } } }
        }
      ]
    }
  }
}
